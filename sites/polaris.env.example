# Site config for ALCF Polaris. Copy to sites/site.env (untracked) and fill in the <...> values.
# Every toolkit script sources sites/site.env (or the file named by $FDP_SITE_ENV).
SITE=polaris
PROJECT=<YOUR_PROJECT>                                  # PBS -A account
FILESYSTEMS=home:eagle                                  # PBS -l filesystems=
SELECT_EXTRA=":system=polaris"                          # appended to select=N
WORK_ROOT=/eagle/<YOUR_PROJECT>/<YOUR_USERNAME>         # where envs, campaigns and outputs live
FDP_NEW_ENV=$WORK_ROOT/fdp-2026-11/.pixi/envs/default   # new env (fdp-core 1.30 + h5py: ptdata 2.11.5); new signals
FDP_OLD_ENV=$WORK_ROOT/fdp/.pixi/envs/default           # old env (ptdata 1.4.6); ECEI/BES/Mirnov provenance
PROXY=http://proxy.alcf.anl.gov:3128                    # compute nodes only reach the internet through this
FDP_INDEX_SNAPSHOT=json_indexes_2026-06-23_15:20:51     # pinned PTDATA json index snapshot (see docs/04)
# Queues the chain driver may use, with the max number of this series' jobs (running + queued) in each.
# Polaris 2026-11: debug = 1 running + 1 queued per user; debug-scaling = 1 per user counting the running one.
QUEUES="debug:2 debug-scaling:1"
WALLTIME=01:00:00
