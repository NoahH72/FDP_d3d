# Site config for ALCF Aurora. Copy to sites/site.env (untracked) and fill in the <...> values.
# NOT YET VERIFIED on Aurora: the queue names/limits, the proxy, and the pixi install. Check each one
# (docs/07_AURORA.md, "First session on Aurora") before trusting it.
SITE=aurora
PROJECT=<YOUR_PROJECT>
FILESYSTEMS=home:flare                                  # check: qsub -l filesystems= names on Aurora
SELECT_EXTRA=""
WORK_ROOT=/lus/flare/projects/<YOUR_PROJECT>/<YOUR_USERNAME>
FDP_NEW_ENV=$WORK_ROOT/fdp-2026-11/.pixi/envs/default
FDP_OLD_ENV=                                            # not needed on Aurora unless you must match old stores bit for bit
PROXY=http://proxy.alcf.anl.gov:3128                    # check: ALCF documents this proxy for Aurora compute nodes too
FDP_INDEX_SNAPSHOT=json_indexes_2026-06-23_15:20:51     # same pin as Polaris unless you deliberately move a campaign
QUEUES="debug:1"                                        # check `qstat -Q` and the ALCF Aurora queue page, then edit
WALLTIME=01:00:00
