# Copy to polaris_ptdata.env (gitignored) and uncomment + set values.
# On Polaris, confirm paths with ALCF / FDP documentation.
#
#   cp polaris_ptdata.env.example polaris_ptdata.env
#
# export PTDATA_ROOT=/path/to/ptdata
# export TOKSEARCH_INDEX_FILE=/path/to/current.db
# export TOKSEARCH_INDEX_DIR=/path/to/dbs/current
#
# Saga BeeGFS mirror (reference only — not on Polaris login nodes by default):
# export PTDATA_ROOT=/mnt/beegfs/archives/ptdata
# export TOKSEARCH_INDEX_FILE=/mnt/beegfs/archives/index/current.db
# export TOKSEARCH_INDEX_DIR=/mnt/beegfs/archives/index/dbs/current
