#!/bin/bash
#PBS -N ecei_benchmark
#PBS -o /home/harris_72/pbs/ecei_benchmark.out
#PBS -e /home/harris_72/pbs/ecei_benchmark.err
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
#PBS -q debug
#
# Run ECEI fetch benchmarks to measure xrdcp, PtDataSignal, and parallel
# pre-stage performance.
#
# Submit:
#   mkdir -p ~/pbs && qsub -A fusiondl_aesp run_benchmark.pbs

set -u

FDP_ROOT="/eagle/fusiondl_aesp/harrisn/fdp"
FDP_PY="$FDP_ROOT/.pixi/envs/default/bin/python"
FDP_CLI="$FDP_ROOT/.pixi/envs/default/bin/fdp"
REPO_ROOT="/eagle/fusiondl_aesp/harrisn/ECEI-Data"

export CONDA_PREFIX="$FDP_ROOT/.pixi/envs/default"
export PREFIX="$CONDA_PREFIX"

# Proxy
FDP_PROXY_ADDR_FILE="$FDP_ROOT/.proxy_addr"
if [ -f "$FDP_PROXY_ADDR_FILE" ]; then
  _PROXY_ADDR="$(cat "$FDP_PROXY_ADDR_FILE" | tr -d '[:space:]')"
else
  echo "ERROR: proxy address file not found: $FDP_PROXY_ADDR_FILE"
  exit 1
fi
export ALL_PROXY="http://${_PROXY_ADDR}"
export all_proxy="$ALL_PROXY"

if curl -s --max-time 10 --proxy "$ALL_PROXY" https://osg-htc.org -o /dev/null; then
  echo "Proxy reachable: $ALL_PROXY"
else
  echo "ERROR: proxy not reachable at $ALL_PROXY"
  exit 1
fi

export PYTHONUNBUFFERED=1
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1

PY_PREFIX="$(dirname "$(dirname "$FDP_PY")")"
export LD_LIBRARY_PATH="${PY_PREFIX}/lib:${LD_LIBRARY_PATH:-}"

echo "=========================================="
echo "ECEI Fetch Benchmark"
echo "Job ID: $PBS_JOBID"
echo "Node: $HOSTNAME"
echo "Start: $(date)"
echo "=========================================="

cd "$REPO_ROOT" || exit 1
"$FDP_CLI" run "$FDP_PY" benchmark_fetch.py

echo "=========================================="
echo "End: $(date)"
echo "=========================================="
